# Auth mode: "oauth" (MusicBrainz OAuth) or "none" (username-only, no auth)
NUXT_PUBLIC_AUTH_MODE=oauth

# MusicBrainz OAuth2 (required when AUTH_MODE=oauth)
NUXT_MUSICBRAINZ_CLIENT_ID=
NUXT_MUSICBRAINZ_CLIENT_SECRET=

# Base URL of your instance (used for OAuth redirect)
NUXT_PUBLIC_BASE_URL=http://localhost:3000
