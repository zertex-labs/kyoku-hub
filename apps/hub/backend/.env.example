# Required
DATABASE_URL=postgres://kyoku:kyoku@localhost:5432/kyoku_hub?sslmode=disable
MUSICBRAINZ_CLIENT_ID=
MUSICBRAINZ_CLIENT_SECRET=
SESSION_SECRET=

# Optional (defaults shown)
PORT=8080
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
BRAINZ_WS_URL=ws://localhost:8081/ws
BRAINZ_API_URL=http://localhost:8081/api
INSTANCE_ID=hub-dev-01

# Tidal downloader (optional — /api/download returns 503 if unset)
# Get via tidal device auth: packages/downloader/tidal/auth.go RequestDeviceCode/PollForToken
TIDAL_TOKEN=
TIDAL_REFRESH_TOKEN=
TIDAL_USER_ID=
TIDAL_COUNTRY_CODE=US
TIDAL_EXPIRES_AT=
DOWNLOAD_DIR=./downloads
